# Copy to .env and fill in. Never commit .env (pipeline/docs/RULES.md).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Set PROVIDER=gemini when using user-repo/contextforge.gemini.yml.
PROVIDER=openai

# GitHub App permissions: Contents: read, Pull requests: read,
# Checks: read/write, and Issues: read/write (for the PR result comment).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
CONTEXTFORGE_WEBHOOK_SECRET=

# One-repository trusted-local development service. GitHub must be able to
# reach this URL over HTTPS; forward /webhooks/github, /reports/*, and /health
# to the loopback listener. Do not expose this host to untrusted PR code.
CONTEXTFORGE_GITHUB_REPOSITORY=owner/repo
CONTEXTFORGE_REPOSITORY_PATH=
CONTEXTFORGE_CONFIG_PATH=contextforge.yml
CONTEXTFORGE_PUBLIC_URL=https://contextforge.example.com
CONTEXTFORGE_HOST=127.0.0.1
CONTEXTFORGE_PORT=3000
CONTEXTFORGE_DATA_DIR=

# Only these names can be passed from this process into the evaluator/app.
# Keep GitHub App credentials and CONTEXTFORGE_* names out of these lists.
CONTEXTFORGE_EVALUATION_ENV_KEYS=OPENAI_API_KEY,GEMINI_API_KEY
CONTEXTFORGE_APP_ENV_KEYS=PROVIDER,OPENAI_API_KEY,GEMINI_API_KEY,OPENAI_BASE_URL,GEMINI_EMBEDDING_BASE_URL,GENERATION_MODEL,EMBEDDING_MODEL,REASONING_EFFORT,TOP_K
