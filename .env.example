# Copy to .env and fill in. Never commit .env (docs/RULES.md).

# Judge model provider used by the evaluator container and by
# `contextforge dataset generate`. Read from the environment only; it is never
# baked into a Docker image.
OPENAI_API_KEY=

# The RAG app under test receives only the variables named in
# `app.env_passthrough` in contextforge.yml. Add that app's keys here too.

# Used by the GitHub Action to post the sticky PR comment and set the check
# status. In CI this is supplied as ${{ secrets.GITHUB_TOKEN }}.
GITHUB_TOKEN=

