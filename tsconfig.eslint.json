{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@contextforge/shared": ["./pipeline/packages/shared/src/index.ts"],
      "@contextforge/cli": ["./pipeline/packages/cli/src/index.ts"]
    }
  },
  "include": [
    "pipeline/packages/*/src/**/*.ts",
    "pipeline/packages/*/test/**/*.ts",
    "user-repo/*/src/**/*.ts",
    "user-repo/*/test/**/*.ts",
    "*.ts"
  ]
}
