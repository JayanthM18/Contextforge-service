{
  "name": "contextforge",
  "version": "0.0.0",
  "private": true,
  "description": "CI regression testing for RAG applications",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force && tsc -p user-repo/sample-rag-app/tsconfig.json && tsc -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "sample-app": "pnpm --filter @contextforge/sample-rag-app start",
    "test:evaluator": "docker build --target test --tag contextforge-evaluator-test pipeline/evaluator && docker run --rm contextforge-evaluator-test",
    "measure-noise": "node pipeline/scripts/measure-noise.mjs",
    "validate-regressions": "pipeline/scripts/validate-regressions.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.1"
  }
}
