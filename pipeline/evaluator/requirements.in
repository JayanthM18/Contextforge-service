# Direct dependencies. requirements.txt is the full, exact resolution of these
# for Python 3.12 on linux/x86_64 and is what the image installs.
#
# instructor and openai are constrained explicitly: left alone, the resolver
# backtracks to instructor 1.3.2 (mid-2024), which predates functions Ragas 0.4
# calls. openai is held to 2.x, the line Ragas 0.4 was built against.
#
# langchain-community is capped because Ragas 0.4.3 imports
# langchain_community.chat_models.vertexai at import time, and 0.4.2 removed
# that module: with 0.4.2, `import ragas` fails outright. Found by building the
# image; the unit tests never import Ragas, so they could not have caught it.
ragas==0.4.3
instructor>=1.11
openai>=2,<3
langchain-community<0.4.2
#
# rapidfuzz is a direct requirement because Ragas's test-set generator imports
# it lazily, and Ragas installs it only with its "all" extra, which would also
# pull in transformers and PyTorch. Without it, `dataset generate` fails the
# moment generation starts.
rapidfuzz
